# Resend API Configuration
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# From email must be from your verified domain in Resend
RESEND_FROM_EMAIL=Monzon Labs <contact@monzonlabs.com>

# Where contact form messages are sent
CONTACT_TO_EMAIL=danny@monzonlabs.com

# --- Anti-spam: Cloudflare Turnstile ---------------------------------------
# Free captcha. Create a widget at https://dash.cloudflare.com -> Turnstile,
# and add the domain monzonlabs.com (plus localhost for development).
#
# If these keys are missing the captcha is skipped and the other anti-spam
# layers (honeypot, timing, heuristics, rate limiting) still apply.

# Real values belong in .env.local (gitignored) and in the host's
# environment variables - never in this file, which is committed.

# Public site key - rendered in the browser
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAAxxxxxxxxxxxxxx

# Secret key - server-side verification only, never expose it
TURNSTILE_SECRET_KEY=0x4AAAAAAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
